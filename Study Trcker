    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
    
    <style>
        /* Theme Variables */
        :root {
            --bg-color: #121212;
            --text-color: #ffffff;
            --card-bg: #1e1e1e;
            --primary-color: #00E676;
            --header-grad-1: #1f1c2c;
            --header-grad-2: #928dab;
            --border-color: #333;
            --input-bg: #2a2a2a;
        }

        body.theme-light {
            --bg-color: #f4f6f9;
            --text-color: #2c3e50;
            --card-bg: #ffffff;
            --primary-color: #27ae60;
            --header-grad-1: #3498db;
            --header-grad-2: #8e44ad;
            --border-color: #e0e0e0;
            --input-bg: #ecf0f1;
        }

        body.theme-blue {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --card-bg: #1e293b;
            --primary-color: #38bdf8;
            --header-grad-1: #0ea5e9;
            --header-grad-2: #1e3a8a;
            --border-color: #334155;
            --input-bg: #0f172a;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Poppins', sans-serif; }
        body { background-color: var(--bg-color); color: var(--text-color); padding-bottom: 30px; transition: 0.3s; overflow-x: hidden; }

        /* Toast Popup */
        #toast {
            visibility: hidden; width: 85%; max-width: 380px;
            background: linear-gradient(135deg, #FFD700, #FF9800); color: #000;
            text-align: center; border-radius: 20px; padding: 14px 18px;
            position: fixed; z-index: 2000; left: 50%; bottom: 30px;
            transform: translateX(-50%); font-weight: 600; font-size: 0.85rem;
            transition: opacity 0.3s, bottom 0.3s; opacity: 0; line-height: 1.4;
        }
        #toast.show { visibility: visible; opacity: 1; bottom: 40px; }

        /* Header */
        header { background: linear-gradient(135deg, var(--header-grad-1), var(--header-grad-2)); padding: 20px; border-bottom-left-radius: 20px; border-bottom-right-radius: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); transition: 0.3s; }
        .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .menu-btn { font-size: 1.5rem; background: rgba(0,0,0,0.3); border: none; color: #fff; padding: 5px 12px; border-radius: 8px; cursor: pointer; }
        .header-title { flex-grow: 1; margin-left: 15px; font-size: 1.2rem; font-weight: 700; color: #fff;}
        .streak-box { background: rgba(255, 255, 255, 0.2); padding: 6px 12px; border-radius: 20px; font-weight: 600; font-size: 0.8rem; color: #fff; }
        .countdown-container { background: rgba(0, 0, 0, 0.3); padding: 15px; border-radius: 15px; text-align: center; color: #fff; }
        #countdown { display: flex; justify-content: space-between; margin-top: 10px; }
        #countdown div { display: flex; flex-direction: column; align-items: center; }
        #countdown span { font-size: 1.3rem; font-weight: 700; color: #00E676; }
        #countdown small { font-size: 0.7rem; color: #ddd; }
        .score-container { text-align: center; margin-top: 15px; font-size: 1.1rem; font-weight: 600; color: #fff; }

        /* Main Tabs */
        .tabs { display: flex; justify-content: space-around; padding: 12px 5px; background: var(--card-bg); margin: 15px; border-radius: 12px; position: sticky; top: 10px; z-index: 100; box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
        .tab-btn { background: none; border: none; color: #888; font-size: 0.85rem; font-weight: 600; cursor: pointer; padding: 5px 10px; transition: 0.3s; }
        .tab-btn.active { color: var(--primary-color); border-bottom: 2px solid var(--primary-color); }

        /* Content Area */
        .tab-content { display: none; padding: 0 15px; }
        .tab-content.active { display: block; }
        .chapter-card { background: var(--card-bg); margin-bottom: 15px; padding: 15px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); transition: 0.3s; }
        .chapter-title { font-size: 1rem; font-weight: 600; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 6px; }
        .tasks-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 8px; }
        .task-item { display: flex; flex-direction: column; align-items: center; text-align: center; }
        .task-item label { font-size: 0.65rem; margin-top: 5px; color: var(--text-color); opacity: 0.8; }

        /* Checkboxes and Counters */
        input[type="checkbox"] { appearance: none; width: 24px; height: 24px; background: var(--input-bg); border: 2px solid var(--border-color); border-radius: 6px; cursor: pointer; }
        input[type="checkbox"]:checked { background: var(--primary-color); border-color: var(--primary-color); position: relative; }
        input[type="checkbox"]:checked::after { content: "✔"; position: absolute; color: #fff; font-size: 14px; font-weight: bold; top: 50%; left: 50%; transform: translate(-50%, -50%); }
        .counter-btn { min-width: 28px; height: 24px; background: var(--input-bg); border: 2px solid #3d8bff; color: #3d8bff; border-radius: 6px; font-weight: bold; font-size: 0.8rem; display: flex; align-items: center; justify-content: center; cursor: pointer; user-select: none; }
        .counter-btn.active { background: #3d8bff; color: #fff; box-shadow: 0 0 8px rgba(61, 139, 255, 0.5); }

        /* Sidebar */
        #overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 900; display: none; }
        #overlay.active { display: block; }
        #sidebar { position: fixed; top: 0; left: -100%; width: 290px; height: 100vh; background: var(--card-bg); z-index: 1000; box-shadow: 4px 0 15px rgba(0,0,0,0.5); transition: left 0.3s ease; overflow-y: auto; }
        #sidebar.open { left: 0; }
        .sidebar-header { display: flex; justify-content: space-between; align-items: center; padding: 20px; background: var(--header-grad-1); color: #fff; }
        .sidebar-header h2 { user-select: none; cursor: pointer; } 
        .close-btn { font-size: 1.5rem; color: #fff; background: none; border: none; cursor: pointer; }

        /* Accordion & Settings */
        .accordion-item { border-bottom: 1px solid var(--border-color); }
        .accordion-header { width: 100%; text-align: left; background: none; border: none; padding: 18px 20px; font-size: 1rem; font-weight: 600; color: var(--text-color); cursor: pointer; display: flex; justify-content: space-between; align-items: center; transition: background 0.3s; }
        .accordion-header:hover { background: var(--input-bg); }
        .accordion-header::after { content: '▼'; font-size: 0.8rem; transition: transform 0.3s; }
        .accordion-header.active::after { transform: rotate(180deg); }
        .accordion-content { max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.4s ease; background: var(--bg-color); }
        .accordion-content.open { max-height: 1200px; padding: 15px 20px; overflow-y: auto; }
        .settings-input, .settings-select { width: 100%; padding: 10px; background: var(--input-bg); border: 1px solid var(--border-color); color: var(--text-color); border-radius: 6px; margin-bottom: 12px; font-size: 0.85rem; }
        .settings-btn { background: var(--primary-color); color: #000; border: none; padding: 10px 14px; font-weight: 600; border-radius: 6px; cursor: pointer; font-size: 0.85rem; width: 100%; margin-bottom: 8px; }
        
        .quiz-btn { color: #fff; font-size: 0.95rem; padding: 12px; font-weight: 700; margin-bottom: 10px;}
        .study-btn { color: #fff; font-size: 0.90rem; padding: 10px; font-weight: 600; margin-bottom: 8px; background: #00796b; }
        .bypass-btn { color: #fff; font-size: 0.90rem; padding: 10px; font-weight: 600; margin-bottom: 8px; background: #229ED9; }
        
        .danger-btn { background: #ff5252; color: #fff; margin-top: 10px; }
        .item-row { display: flex; justify-content: space-between; align-items: center; background: var(--card-bg); padding: 8px 10px; border-radius: 6px; margin-bottom: 8px; font-size: 0.8rem; border: 1px solid var(--border-color); }
        .item-row button { background: #ff5252; color: #fff; border: none; padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; cursor: pointer; }
        #secretLinkSection { display: none; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 8px; border: 1px dashed #00E676; margin-bottom: 20px; }

        /* FLOATING REAL GEMINI BUTTON */
        #ai-widget-btn { 
            position: fixed; 
            right: 20px; 
            bottom: 20px; 
            z-index: 9999999; 
            background: linear-gradient(135deg, #2575fc, #6a11cb); 
