        // APP LOGIC & CONFIGURATION
        const fullSyllabus = {
            physics: ["Basic Math & Calculus", "Units and Measurements", "Motion in a Straight Line", "Motion in a Plane", "Laws of Motion", "Work, Energy and Power", "System of Particles and Rotational Motion", "Gravitation", "Mechanical Properties of Solids", "Mechanical Properties of Fluids", "Thermal Properties of Matter", "Thermodynamics", "Kinetic Theory of Gases", "Oscillations", "Waves", "Electric Charges and Fields", "Electrostatic Potential and Capacitance", "Current Electricity", "Moving Charges and Magnetism", "Magnetism and Matter", "Electromagnetic Induction", "Alternating Current", "Electromagnetic Waves", "Ray Optics and Optical Instruments", "Wave Optics", "Dual Nature of Radiation and Matter", "Atoms", "Nuclei", "Semiconductor Electronics"],
            chemistry: ["Some Basic Concepts of Chemistry", "Structure of Atom", "Classification of Elements and Periodicity", "Chemical Bonding and Molecular Structure", "Thermodynamics", "Equilibrium", "Redox Reactions", "Solutions", "Electrochemistry", "Chemical Kinetics", "p-Block Elements", "d and f Block Elements", "Coordination Compounds", "Organic Chemistry: Some Basic Principles and Techniques", "Hydrocarbons", "Haloalkanes and Haloarenes", "Alcohols, Phenols and Ethers", "Aldehydes, Ketones and Carboxylic Acids", "Amines", "Biomolecules"],
            biology: ["The Living World", "Biological Classification", "Plant Kingdom", "Animal Kingdom", "Morphology of Flowering Plants", "Anatomy of Flowering Plants", "Structural Organisation in Animals", "Cell: The Unit of Life", "Biomolecules", "Cell Cycle and Cell Division", "Photosynthesis in Higher Plants", "Respiration in Plants", "Plant Growth and Development", "Breathing and Exchange of Gases", "Body Fluids and Circulation", "Excretory Products and Their Elimination", "Locomotion and Movement", "Neural Control and Coordination", "Chemical Coordination and Integration", "Sexual Reproduction in Flowering Plants", "Human Reproduction", "Reproductive Health", "Principles of Inheritance and Variation", "Molecular Basis of Inheritance", "Evolution", "Human Health and Disease", "Microbes in Human Welfare", "Biotechnology: Principles and Processes", "Biotechnology and its Applications", "Organisms and Populations", "Ecosystem", "Biodiversity and Conservation"]
        };
        const defaultTasks = ["Lecture", "Notes Rev", "DPP", "Q. Practice", "PYQ", "Revision"];
        const bioTasks = ["Lecture", "NCERT Read", "Notes Rev", "DPP", "Q. Practice", "PYQ", "Revision"];

        let appName = localStorage.getItem('neetAppName') || "NEET Tracker Pro";
        let syllabusData = JSON.parse(localStorage.getItem('neetCustomSyllabus')) || fullSyllabus;
        let tasksConfig = JSON.parse(localStorage.getItem('neetCustomTasks')) || defaultTasks;
        let bioTasksConfig = JSON.parse(localStorage.getItem('neetCustomBioTasks')) || bioTasks;
        let trackerData = JSON.parse(localStorage.getItem('neetTrackerData')) || {};
        let savedTheme = localStorage.getItem('neetAppTheme') || "theme-dark";
        document.body.className = savedTheme;

        // Custom Overridden Direct Links
        let customQuizLinks = JSON.parse(localStorage.getItem('neetCustomQuizLinks')) || ["", "", ""];
        let customStudyLinks = JSON.parse(localStorage.getItem('neetCustomStudyLinks')) || ["", "", "", "", ""];
        let customBypassLinks = JSON.parse(localStorage.getItem('neetCustomBypassLinks')) || ["", ""];

        let adminPin = localStorage.getItem('neetAdminPin') || "1234";
        let secretClicks = 0;
        let secretTimer = null;

        function initApp() {
            document.getElementById('appHeaderName').innerText = appName;
            document.getElementById('appWindowTitle').innerText = appName;
            document.getElementById('appNameInput').value = appName;
            document.getElementById('themeSelect').value = savedTheme;

            // Load saved custom inputs if present
            for(let i=0; i<3; i++) document.getElementById(`linkInputQuiz${i+1}`).value = customQuizLinks[i] || QUIZ_LINKS[i] || "";
            for(let i=0; i<5; i++) document.getElementById(`linkInputStudy${i+1}`).value = customStudyLinks[i] || STUDY_LINKS[i] || "";
            for(let i=0; i<2; i++) document.getElementById(`linkInputBypass${i+1}`).value = customBypassLinks[i] || BYPASS_LINKS[i] || "";

            renderSubjects(); updateScoreAndGraphs(); calculateStreak(); startCountdown(); renderSettingsPanel();
        }

        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('overlay').classList.toggle('active');
        }

        function toggleAccordion(btn) {
            const content = btn.nextElementSibling;
            document.querySelectorAll('.accordion-header').forEach(h => {
                if(h !== btn) { h.classList.remove('active'); h.nextElementSibling.classList.remove('open'); }
            });
            btn.classList.toggle('active'); content.classList.toggle('open');
        }

        function handleSecretClick() {
            secretClicks++; clearTimeout(secretTimer);
            secretTimer = setTimeout(() => { secretClicks = 0; }, 1500); 
            
            if (secretClicks >= 5) {
                secretClicks = 0;
                let entered = prompt("Enter Secret PIN:");
                if (entered === adminPin) {
                    document.getElementById('secretLinkSection').style.display = 'block';
                    const editorBtn = document.querySelectorAll('.accordion-header')[4]; 
                    if(!editorBtn.classList.contains('active')) toggleAccordion(editorBtn);
                    showToast("Secret Links Manager Unlocked! 🔓");
                } else if (entered !== null) { alert("Incorrect PIN!"); }
            }
        }

        function changeAdminPin() {
            let old = prompt("Enter Current Secret PIN:");
            if (old === adminPin) {
                let newPin = prompt("Enter New PIN:");
                if (newPin && newPin.trim() !== "") {
                    adminPin = newPin; localStorage.setItem('neetAdminPin', adminPin); showToast("PIN Changed! ✅");
                }
            }
        }

        function saveAllDirectLinks() {
            for(let i=0; i<3; i++) { customQuizLinks[i] = document.getElementById(`linkInputQuiz${i+1}`).value.trim(); }
            for(let i=0; i<5; i++) { customStudyLinks[i] = document.getElementById(`linkInputStudy${i+1}`).value.trim(); }
            for(let i=0; i<2; i++) { customBypassLinks[i] = document.getElementById(`linkInputBypass${i+1}`).value.trim(); }
            
            localStorage.setItem('neetCustomQuizLinks', JSON.stringify(customQuizLinks));
            localStorage.setItem('neetCustomStudyLinks', JSON.stringify(customStudyLinks));
            localStorage.setItem('neetCustomBypassLinks', JSON.stringify(customBypassLinks));

            showToast("Direct Links Saved! ✅");
            setTimeout(() => { document.getElementById('secretLinkSection').style.display = 'none'; }, 1500);
        }

        function openLink(type, index) {
            toggleSidebar();
            let targetUrl = "";
            if (type === 'quiz') {
                targetUrl = customQuizLinks[index-1] || QUIZ_LINKS[index-1];
            } else if (type === 'study') {
                targetUrl = customStudyLinks[index-1] || STUDY_LINKS[index-1];
            } else if (type === 'bypass') {
                targetUrl = customBypassLinks[index-1] || BYPASS_LINKS[index-1];
            }

            if (targetUrl && targetUrl.trim() !== "") {
                launchUrl(targetUrl);
            } else {
                alert(`${type.toUpperCase()} Link ${index} is empty! Please set a valid link in code or Secret Manager.`);
            }
        }

        function changeTheme() {
            const theme = document.getElementById('themeSelect').value;
            document.body.className = theme; localStorage.setItem('neetAppTheme', theme); updateScoreAndGraphs();
        }
        
        function openTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById(tabName).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        let clickTimers = {}; 
        function renderSubjects() {
            Object.keys(syllabusData).forEach(subject => {
                const container = document.getElementById(subject);
                if(!container) return; container.innerHTML = '';
                const tasks = subject === 'biology' ? bioTasksConfig : tasksConfig;
                if (!trackerData[subject]) trackerData[subject] = {};

                syllabusData[subject].forEach((chapter, chapIndex) => {
                    if (!trackerData[subject][chapter]) trackerData[subject][chapter] = {};
                    const card = document.createElement('div'); card.className = 'chapter-card';
                    let tasksHtml = `<div class="tasks-grid">`;
                    
                    tasks.forEach((task, taskIndex) => {
                        const val = trackerData[subject][chapter][task] || 0;
                        const uniqueId = `${subject}-${chapIndex}-${taskIndex}`;
                        
                        if (task.toLowerCase().includes("revision") || task.toLowerCase().includes("ncert")) {
                            tasksHtml += `<div class="task-item"><button class="counter-btn ${val > 0 ? 'active' : ''}" onclick="handleSmartClick('${subject}', '${chapter}', '${task}', '${uniqueId}')">${val}</button><label>${task}</label></div>`;
                        } else {
                            tasksHtml += `<div class="task-item"><input type="checkbox" id="${uniqueId}" onchange="toggleTask('${subject}', '${chapter}', '${task}', this.checked)" ${val ? 'checked' : ''}><label for="${uniqueId}">${task}</label></div>`;
                        }
                    });
                    tasksHtml += `</div>`;
                    card.innerHTML = `<div class="chapter-title">${chapter}</div> ${tasksHtml}`;
                    container.appendChild(card);
                });
            });
        }

        function handleSmartClick(sub, chap, task, id) { 
            if (clickTimers[id]) { 
                clearTimeout(clickTimers[id]); delete clickTimers[id]; handleCounterChange(sub, chap, task, -1); 
            } else { 
                clickTimers[id] = setTimeout(() => { delete clickTimers[id]; handleCounterChange(sub, chap, task, 1); }, 280); 
            } 
        }

        function handleCounterChange(sub, chap, task, change) { 
            let val = trackerData[sub][chap][task] || 0; 
            if (change === -1 && val === 0) return; 
            trackerData[sub][chap][task] = val + change; 
            saveData(); renderSubjects(); updateScoreAndGraphs(); 
            if(change > 0) {
                const randomShayari = shayaris[Math.floor(Math.random() * shayaris.length)];
                showToast(`🎉 Point Added!\n${randomShayari}`);
            } else {
                showToast(`⚠️ Score reduced for ${task}`);
            }
        }

        function toggleTask(sub, chap, task, checked) { 
            trackerData[sub][chap][task] = checked ? 1 : 0; 
            saveData(); updateScoreAndGraphs(); 
            if (checked) {
                const randomShayari = shayaris[Math.floor(Math.random() * shayaris.length)];
                showToast(`🎉 Task Completed!\n${randomShayari}`);
            }
        }
        
        function saveData() { 
            localStorage.setItem('neetTrackerData', JSON.stringify(trackerData)); 
            localStorage.setItem('neetCustomSyllabus', JSON.stringify(syllabusData)); 
            localStorage.setItem('neetCustomTasks', JSON.stringify(tasksConfig)); 
            localStorage.setItem('neetCustomBioTasks', JSON.stringify(bioTasksConfig)); 
            localStorage.setItem('neetAppName', appName); 
        }
        
        function showToast(msg) { 
            const toast = document.getElementById("toast"); 
            toast.innerHTML = msg.replace('\n', '<br><span style="font-size:0.75rem; font-weight:400; opacity: 0.9; line-height: 1.5; display: inline-block; margin-top: 5px;">') + '</span>';
            toast.className = "show"; 
            setTimeout(() => { toast.className = toast.className.replace("show", ""); }, 10000); 
        }

        let overallChart, subjectChart, radarChart;
        function updateScoreAndGraphs() {
            let total = 0, max = 0, subScores = { physics: 0, chemistry: 0, biology: 0 }, subMax = { physics: 0, chemistry: 0, biology: 0 }, taskStats = {}; 
            Object.keys(syllabusData).forEach(sub => {
                const tasks = sub === 'biology' ? bioTasksConfig : tasksConfig;
                syllabusData[sub].forEach(chap => { max += tasks.length; subMax[sub] += tasks.length; tasks.forEach(task => { if(!taskStats[task]) taskStats[task] = { done: 0, total: 0 }; taskStats[task].total += 1; const val = (trackerData[sub] && trackerData[sub][chap]) ? (trackerData[sub][chap][task] || 0) : 0; if (val > 0) { total += val; subScores[sub] += val; taskStats[task].done += 1; } }); });
            });
            document.getElementById('totalScore').innerText = total; document.getElementById('maxScore').innerText = max;
            const getP = (val, max) => max === 0 ? 0 : (val / max) * 100;
            const tc = document.body.classList.contains('theme-light') ? '#333' : '#fff'; const gc = document.body.classList.contains('theme-light') ? 'rgba(0,0,0,0.1)' : 'rgba(255,255,255,0.1)';
            if(overallChart) overallChart.destroy(); overallChart = new Chart(document.getElementById('overallChart'), { type: 'doughnut', data: { labels: ['Done', 'Pending'], datasets: [{ data: [getP(total, max), 100-getP(total, max)], backgroundColor: ['#00E676', '#555'], borderWidth: 0 }] }, options: { cutout: '75%', plugins: { legend: { labels: { color: tc } } } } });
            if(subjectChart) subjectChart.destroy(); subjectChart = new Chart(document.getElementById('subjectChart'), { type: 'bar', data: { labels: ['Phy', 'Chem', 'Bio'], datasets: [{ label: '% Done', data: [getP(subScores.physics, subMax.physics), getP(subScores.chemistry, subMax.chemistry), getP(subScores.biology, subMax.biology)], backgroundColor: ['#FF5252', '#FFC107', '#00E676'], borderRadius: 6 }] }, options: { scales: { y: { beginAtZero: true, max: 100, ticks: { color: tc }, grid: { color: gc } }, x: { ticks: { color: tc }, grid: { display: false } } }, plugins: { legend: { display: false } } } });
            const labels = Object.keys(taskStats); const radarData = labels.map(l => getP(taskStats[l].done, taskStats[l].total));
            if(radarChart) radarChart.destroy(); radarChart = new Chart(document.getElementById('radarChart'), { type: 'radar', data: { labels: labels, datasets: [{ label: 'Mastery %', data: radarData, backgroundColor: 'rgba(0, 230, 118, 0.2)', borderColor: '#00E676', pointBackgroundColor: '#00E676' }] }, options: { scales: { r: { angleLines: { color: gc }, grid: { color: gc }, pointLabels: { color: tc, font: {size: 10} }, ticks: { display: false, max: 100, beginAtZero: true } } }, plugins: { legend: { display: false } } } });
        }

        function saveAppName() { const val = document.getElementById('appNameInput').value.trim(); if (val) { appName = val; saveData(); document.getElementById('appHeaderName').innerText = appName; showToast("Name Updated!"); } }
        function renderSettingsPanel() {
            const subType = document.getElementById('taskSubjectSelect').value, activeTasks = subType === 'biology' ? bioTasksConfig : tasksConfig;
            document.getElementById('currentTaskList').innerHTML = activeTasks.map((t, i) => `<div class="item-row"><span>${t}</span><button onclick="removeTask('${subType}', ${i})">X</button></div>`).join('');
            const chapSub = document.getElementById('chapterSubjectSelect').value;
            document.getElementById('currentChapterList').innerHTML = syllabusData[chapSub].map((c, i) => `<div class="item-row"><span>${c}</span><button onclick="removeChapter('${chapSub}', ${i})">X</button></div>`).join('');
        }
        document.getElementById('taskSubjectSelect').addEventListener('change', renderSettingsPanel); document.getElementById('chapterSubjectSelect').addEventListener('change', renderSettingsPanel);
        function addNewTask() { const val = document.getElementById('newTaskInput').value.trim(), sub = document.getElementById('taskSubjectSelect').value; if(!val) return; (sub === 'biology' ? bioTasksConfig : tasksConfig).push(val); document.getElementById('newTaskInput').value = ''; saveData(); renderSubjects(); renderSettingsPanel(); updateScoreAndGraphs(); }
        function removeTask(sub, i) { (sub === 'biology' ? bioTasksConfig : tasksConfig).splice(i, 1); saveData(); renderSubjects(); renderSettingsPanel(); updateScoreAndGraphs(); }
        function addNewChapter() { const val = document.getElementById('newChapterInput').value.trim(), sub = document.getElementById('chapterSubjectSelect').value; if(!val) return; syllabusData[sub].push(val); document.getElementById('newChapterInput').value = ''; saveData(); renderSubjects(); renderSettingsPanel(); updateScoreAndGraphs(); }
        function removeChapter(sub, i) { syllabusData[sub].splice(i, 1); saveData(); renderSubjects(); renderSettingsPanel(); updateScoreAndGraphs(); }
        function resetToDefaultData() { if(confirm("Factory Reset? All data will be lost.")) { localStorage.clear(); location.reload(); } }

        function startCountdown() { const tgt = new Date("May 2, 2027 14:00:00").getTime(); setInterval(() => { const diff = tgt - new Date().getTime(); if (diff < 0) return; document.getElementById("months").innerText = Math.floor(diff / (1000 * 60 * 60 * 24 * 30)); document.getElementById("days").innerText = Math.floor((diff % (1000 * 60 * 60 * 24 * 30)) / (1000 * 60 * 60 * 24)); document.getElementById("hours").innerText = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)); document.getElementById("minutes").innerText = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)); document.getElementById("seconds").innerText = Math.floor((diff % (1000 * 60)) / 1000); }, 1000); }
        function calculateStreak() { let last = localStorage.getItem('lastLoginDate'), streak = parseInt(localStorage.getItem('streakCount')) || 0, today = new Date().toDateString(); if (last !== today) { let yest = new Date(); yest.setDate(yest.getDate() - 1); streak = (last === yest.toDateString()) ? streak + 1 : 1; localStorage.setItem('lastLoginDate', today); localStorage.setItem('streakCount', streak); } document.getElementById('streakCount').innerText = streak; }

        initApp();
    </script>
