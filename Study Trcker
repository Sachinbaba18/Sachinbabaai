            border: none; 
            padding: 12px 20px;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 700;
            box-shadow: 0 6px 20px rgba(37, 117, 252, 0.5); 
            cursor: pointer; 
            display: flex; 
            align-items: center; 
            gap: 8px;
            transition: transform 0.3s; 
        }
        #ai-widget-btn:hover { transform: scale(1.08); }
    </style>
</head>
